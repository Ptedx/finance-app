// Spendr — schema do servidor.
//
// Regra que atravessa o arquivo inteiro: os tipos aqui espelham o SQLite do app
// (`app/database/schema.ts`) coluna a coluna. Sincronizar é copiar, não converter —
// toda tradução na borda seria mais um lugar onde um centavo pode se perder.
//
// Três consequências disso:
//
//  1. Dinheiro é `amountCents BigInt`, nunca Decimal ou Float. Ver `app/utils/money.ts`.
//     BigInt, e não Int, porque o teto do app é 10¹⁵ centavos (`MAX_CENTS`) e o de um
//     Int são 2,1 bilhões: com a coluna menor que o campo, um valor entre os dois era
//     gravado no aparelho e recusado no sync. O teto vale nos dois lados, em
//     `MAX_AMOUNT_CENTS` (src/schemas/sync.ts).
//  2. Datas de calendário (`date`, `nextDue`) são `VarChar(10)` no formato YYYY-MM-DD,
//     não DateTime. O app trata essas datas como dia local; virar timestamp UTC jogaria
//     um lançamento do dia 31 às 22h para o mês seguinte.
//  3. `updatedAt` é escrito por quem fez a alteração — inclusive o celular — e por isso
//     NÃO usa `@updatedAt`. É esse campo que decide o last-write-wins.
//  4. `updatedAt` (relógio do cliente) resolve o conflito; `serverSeq` (sequência do
//     servidor) é o cursor do pull. Separar os dois não é preciosismo: um aparelho que
//     passou uma semana offline empurra linhas com `updatedAt` de ontem, e um cursor
//     baseado nesse campo faria os outros aparelhos nunca mais enxergarem essas linhas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL fica no prisma.config.ts (datasource.url = process.env.DATABASE_URL): o
  // Prisma 7 nao aceita mais `url` aqui no schema. Por isso o Dockerfile precisa copiar
  // o prisma.config.ts para a imagem — senao `prisma migrate deploy` nao acha a
  // datasource.url e a API entra em crash-loop na subida.
}

// ============================================
// Perfil
// ============================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  baseCurrency String   @default("BRL")
  language     String   @default("pt-BR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens         RefreshToken[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  retirementGoals       RetirementGoal[]
  debts                 Debt[]
  accounts              Account[]
  transfers             Transfer[]
  assets                Asset[]
  liabilities           Liability[]
  netWorthSnapshots     NetWorthSnapshot[]
  goals                 Goal[]
  portfolioAllocations  PortfolioAllocation[]
  passiveIncomes        PassiveIncome[]

  @@map("users")
}

/// Refresh tokens são opacos e guardados como hash: um dump do banco não pode virar
/// sessão em nome de ninguém. `revokedAt` marca o token já rotacionado.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// Coleções sincronizadas (v1)
// ============================================

enum CategoryType {
  expense
  income
}

/// Custo de viver ou escolha. Base do 50/30/20 no app (`app/utils/metrics.ts`).
///
/// Só é lida em categorias de despesa; nas de receita existe por uniformidade. O padrão
/// é `discretionary` porque classificar um gasto como essencial é uma afirmação do
/// usuário — assumi-la por ele inflaria as "necessidades" de quem nunca abriu a tela.
enum CategoryNature {
  essential
  discretionary
  /// Repasse: dinheiro que só passou pela conta. Desconta da receita, não é gasto.
  passthrough
}

/// A PK é composta `(userId, id)`, e não um uuid do servidor.
///
/// Isso é o que permite as categorias padrão manterem os ids fixos do app ('food',
/// 'salary'), que ficam gravados em `Transaction.category`: o 'food' de um usuário é
/// uma linha diferente do 'food' de outro, e cada um pode renomear ou apagar o seu sem
/// afetar ninguém. Um id global compartilhado tiraria essa liberdade — e o app hoje
/// deixa editar as categorias padrão.
model Category {
  id        String
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  icon      String
  type      CategoryType
  /// Necessidade ou desejo. Tem default para que uma linha vinda de um aparelho anterior
  /// à coluna entre sem o servidor precisar recusá-la.
  nature    CategoryNature @default(discretionary)
  updatedAt DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq Int            @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("categories")
}

/// `category` guarda o id da categoria mas **não** é uma foreign key.
///
/// Numa arquitetura offline-first os aparelhos não sincronizam em ordem: o celular pode
/// enviar um lançamento numa categoria que ainda não subiu, e uma FK rígida rejeitaria
/// um dado perfeitamente legítimo. O push verifica no lugar da FK: categoria
/// desconhecida faz a linha voltar em `rejected` com `unknown_category`, sem gravar
/// nada, e o aparelho reenvia a categoria junto na remessa seguinte (ou, se nem ele a
/// tem mais, move o lançamento para 'uncategorized' e sobe assim). Reancorar aqui no
/// servidor, como era feito, deixava o aparelho de origem com a categoria certa e o
/// servidor com 'uncategorized' — e o empate no last-write-wins eternizava a diferença.
model Transaction {
  id          String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents BigInt
  category    String
  /// Dia de calendário local, YYYY-MM-DD.
  date        String    @db.VarChar(10)
  note        String?   @db.Text
  isIncome    Boolean   @default(false)
  /// Conta ou cartão de origem (v7). Não é FK pelo mesmo motivo de `category`.
  accountId        String?
  /// Parcela de compra parcelada (v7): grupo, índice e total. Nulos à vista.
  installmentGroup String?
  installmentIndex Int?
  installmentCount Int?
  /// Final do cartão que fez a compra (v13).
  cardLast4        String?
  updatedAt   DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt   DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq   Int       @unique @default(autoincrement())

  @@id([userId, id])
  /// O pull filtra exatamente por (dono, o que mudou depois de X).
  @@index([userId, serverSeq])
  @@index([userId, date])
  @@map("transactions")
}

enum RecurrenceType {
  weekly
  monthly
  yearly
}

model RecurringTransaction {
  id             String
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    BigInt
  isIncome       Boolean        @default(false)
  note           String?        @db.Text
  category       String
  recurrenceType RecurrenceType
  day            Int?
  month          Int?
  weekday        Int?
  lastProcessed  String?        @db.VarChar(10)
  nextDue        String?        @db.VarChar(10)
  active         Boolean        @default(true)
  updatedAt      DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt      DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq      Int            @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("recurring_transactions")
}

enum AccountKind {
  checking
  savings
  investment
  cash
  credit_card
}

/// Conta ou cartão (v7). O saldo não é guardado: é `openingBalanceCents` no fim de
/// `openingBalanceDate` mais tudo que vem depois — ver `Account` em app/database/schema.ts.
/// O papel da conta no mês (v8). Ver `AccountRole` em app/database/schema.ts.
enum AccountRole {
  main
  card
  envelope
  reserve
  external
}

model Account {
  id                   String
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  kind                 AccountKind
  role                 AccountRole @default(main)
  envelopeMonthlyCents BigInt?
  /// Bandeira do cartão (v9): visa, mastercard, elo, amex, hipercard.
  network              String?
  bankName            String?
  color               String
  last4               String?
  closingDay          Int?
  dueDay              Int?
  /// Dias entre o fechamento e o vencimento (v10).
  closingDaysBefore   Int?
  /// Nomes dos cartões da conta por final, JSON (v13).
  cardNames           String?
  creditLimitCents    BigInt?
  packageName         String?
  accountKey          String?
  openingBalanceCents BigInt
  /// Dia de calendário local, YYYY-MM-DD.
  openingBalanceDate  String      @db.VarChar(10)
  sortOrder           Int         @default(0)
  archived            Boolean     @default(false)
  updatedAt           DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt           DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq           Int         @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("accounts")
}

/// Dinheiro trocando de bolso entre contas do usuário (v7). Nunca é receita nem
/// despesa; por isso vive fora de `transactions`. Um dos lados pode ser nulo: a
/// outra conta não é acompanhada pelo app.
model Transfer {
  id            String
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String?
  toAccountId   String?
  amountCents   BigInt
  /// Dia de calendário local, YYYY-MM-DD.
  date          String    @db.VarChar(10)
  note          String?   @db.Text
  updatedAt     DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt     DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq     Int       @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@index([userId, date])
  @@map("transfers")
}

/// Orçamento mensal. Único por mês **entre as linhas vivas**: um orçamento apagado
/// mantém a lápide, e definir outro para o mesmo mês não pode esbarrar nela — daí o
/// índice parcial, criado à mão na migration (Prisma não modela `WHERE` em @@unique).
model Budget {
  id          String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents BigInt
  year        Int
  month       Int
  updatedAt   DateTime
  /// Lápide. A linha sobrevive ao delete para que um aparelho que estava offline
  /// saiba que ela sumiu, em vez de reenviá-la achando que é nova.
  deletedAt   DateTime?
  /// Ordem de gravação no servidor. É por ela que o pull pagina — nunca por
  /// `updatedAt`, que vem do relógio de quem editou e pode apontar para o passado.
  serverSeq   Int       @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("budgets")
}

/// A meta de aposentadoria (v14 do app): renda passiva desejada, margem reinvestida,
/// rentabilidade esperada e capital fora do app. Uma linha por usuário, de id fixo
/// ("retirement"), para que dois aparelhos disputem a mesma linha e o LWW resolva.
model RetirementGoal {
  id                  String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetMonthlyCents  BigInt
  reinvestBp          Int
  expectedYieldBp     Int
  outsideCapitalCents BigInt
  updatedAt           DateTime
  deletedAt           DateTime?
  serverSeq           Int       @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("retirement_goals")
}

/// Uma dívida (v15 do app): financiamento (Price/SAC), consórcio ou empréstimo. O saldo é
/// uma âncora (saldo logo depois da última parcela paga, numa data); o de hoje é projetado
/// no app. Texto livre em kind/system em vez de enum: acrescentar um tipo não vira migração.
model Debt {
  id                  String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  kind                String
  system              String
  openingBalanceCents BigInt
  openingBalanceDate  String    @db.VarChar(10)
  installmentCents    BigInt
  remainingAtOpening  Int
  installmentsTotal   Int
  dueDay              Int
  rateBp              Int
  adminFeeBp          Int?
  accountId           String?
  category            String?
  archived            Boolean   @default(false)
  sortOrder           Int       @default(0)
  updatedAt           DateTime
  deletedAt           DateTime?
  serverSeq           Int       @unique @default(autoincrement())

  @@id([userId, id])
  @@index([userId, serverSeq])
  @@map("debts")
}

// ============================================
// Pilar 1: Gestão de Patrimônio (Net Worth)
//
// Os modelos abaixo vêm do ROADMAP_INVESTIMENTOS.md e ainda não têm tela no app nem
// endpoint na API. Ficam no schema para que a primeira migration já reserve o espaço.
// ============================================

model Asset {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AssetType
  balanceCents BigInt
  lastUpdated  DateTime  @default(now())

  @@index([userId])
  @@map("assets")
}

enum AssetType {
  checking
  savings
  brokerage
  real_estate
  vehicle
  other
}

model Liability {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         LiabilityType
  balanceCents BigInt
  dueDate      String?       @db.VarChar(10)
  lastUpdated  DateTime      @default(now())

  @@index([userId])
  @@map("liabilities")
}

enum LiabilityType {
  credit_card
  loan
  mortgage
  other
}

model NetWorthSnapshot {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  String   @db.VarChar(10)
  totalAssetsCents      BigInt
  totalLiabilitiesCents BigInt
  netWorthCents         BigInt
  createdAt             DateTime @default(now())

  @@unique([userId, date])
  @@map("net_worth_snapshots")
}

// ============================================
// Pilar 2: Metas Inteligentes (Sinking Funds)
// ============================================

model Goal {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetAmountCents  BigInt
  currentAmountCents BigInt     @default(0)
  targetDate         String?    @db.VarChar(10)
  icon               String
  color              String
  status             GoalStatus @default(active)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@map("goals")
}

enum GoalStatus {
  active
  completed
  paused
}

// ============================================
// Pilar 4: Alocação de Portfólio
// ============================================

model PortfolioAllocation {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetClass        AssetClass
  /// Pontos-base (1% = 100), pelo mesmo motivo de amountCents: nada de float.
  targetBasisPoints Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, assetClass])
  @@map("portfolio_allocations")
}

enum AssetClass {
  renda_fixa
  acoes_br
  fiis
  exterior
  cripto
}

// ============================================
// Pilar 5: Rastreador de Dividendos
// ============================================

model PassiveIncome {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetName   String
  type        PassiveIncomeType
  amountCents BigInt
  date        String            @db.VarChar(10)
  createdAt   DateTime          @default(now())

  @@index([userId, date])
  @@map("passive_incomes")
}

enum PassiveIncomeType {
  dividend
  interest
  rent
}
