# Build outputs generated inside node_modules by local `expo run:android` /
# `gradlew`. They never exist on a fresh EAS install, so leaving them in the
# fingerprint makes the locally-computed runtimeVersion diverge from the one
# computed during the EAS build, which aborts the build.
node_modules/**/android/build/
node_modules/**/android/.cxx/
node_modules/**/android/.gradle/
node_modules/**/ios/build/
node_modules/**/ios/Pods/

# Metadados que a extensão Java do VS Code (Buildship/Eclipse) grava em cada projeto
# Gradle de node_modules ao abrir a pasta. Também nunca existem no EAS.
node_modules/**/android/.classpath
node_modules/**/android/.project
node_modules/**/android/.settings/
node_modules/**/android/bin/
node_modules/**/.classpath
node_modules/**/.project
node_modules/**/.settings/

# O mesmo nos plugins Gradle que alguns pacotes trazem fora de android/ (expo-modules-core,
# expo-updates, expo-dev-launcher): o build local deixa saída ao lado do código.
node_modules/**/*-gradle-plugin/build/
node_modules/**/*-gradle-plugin/.gradle/
node_modules/**/*-gradle-plugin/.kotlin/
node_modules/**/*-gradle-plugin/bin/
